# Local development only (plain `npm run dev`, backend on :8000).
# NOT needed on Vercel: the app calls the backend same-origin there.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: point the server-side /api/* proxy routes at an externally
# hosted backend (e.g. Render) instead of the Vercel service binding.
# Takes precedence over BACKEND_URL when both are set. Server-only —
# never add a NEXT_PUBLIC_ prefix here, or the URL would leak to browsers.
# No secrets below: this is a public base URL, not a credential.
# RENDER_BACKEND_URL=https://money-detective-backend.onrender.com
